# --- Serveris ---
PORT=3000
NODE_ENV=development

# Nustatykite true, kai dirbate per HTTPS (sesijos slapukas taps Secure)
COOKIE_SECURE=false

# --- MySQL / MariaDB ---
# Hostingeryje sias reiksmes rasite hostingo panelej (Duomenu bazes -> MySQL).
#
# DB_HOST: naudokite 127.0.0.1, o NE localhost. Nuo Node 17 'localhost'
# pirmiausia issprendziamas i IPv6 (::1), o MySQL teises paprastai duodamos
# tik 'user@localhost' / 'user@127.0.0.1'. Tada prisijungimas atmetamas su
# ER_ACCESS_DENIED_ERROR, nors slaptazodis teisingas.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=warehouse
DB_PASSWORD=warehouse
DB_NAME=warehouse_ops

# Alternatyva: viena eilute vietoj DB_* kintamuju
# DATABASE_URL=mysql://vartotojas:slaptazodis@localhost:3306/warehouse_ops

# Nustatykite true, jei DB reikalauja SSL (dazniausiai nuotoliniam prisijungimui)
DB_SSL=false

# --- Verslo taisykles ---
# Sandelio laiko juosta (naudojama dienos filtrams ir CSV eksportui).
# Duomenu bazeje viskas saugoma UTC, o si juosta lemia, kur prasideda "siandien".
APP_TIMEZONE=Europe/Vilnius

# Po kiek minuciu laukiantis vilkikas pazymimas kaip "per ilgai laukia"
WAITING_ALERT_MINUTES=30
# Velavimo tolerancija minutemis (0 = veluoja iskart po planuoto laiko)
LATE_GRACE_MINUTES=0

# Didžiausias vieno prisegto dokumento dydis MB (PDF, JPG, PNG, Excel)
UPLOAD_MAX_MB=15

# Viesas programos adresas, naudojamas vairuotojo atvykimo QR kode.
# Production pavyzdys: https://dock.cubivo.lt
# PUBLIC_BASE_URL=

# --- Pirmasis administratorius be SSH -------------------------------
#  Naudinga bendrame hostinge, kur `npm run create-admin` paleisti negalima.
#  Paskyra sukuriama TIK jei users lentele visiskai tuscia, todel antro
#  administratoriaus sie kintamieji nesukurs ir esamo neperrasys.
#  Prisijungus rekomenduojama juos pasalinti.
# BOOTSTRAP_ADMIN_EMAIL=admin@cubivo.lt
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Vardas Pavarde

# --- Pradinis administratorius (naudoja npm run seed) ---
SEED_ADMIN_EMAIL=admin@sandelis.lt
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Sistemos administratorius
